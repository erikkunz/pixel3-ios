diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index b6c1a41..ef1cbf1 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -273,7 +273,7 @@ ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
 	dwc_wr(DEPCMDPAR1(ep), p1);
 	dwc_wr(DEPCMDPAR2(ep), p2);
 	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
-	for (int i = 0; i < 1000; i++) {
+	for (int i = 0; i < 20000; i++) {	/* Pixel 3: allow 20 ms */
 		uint32_t v = dwc_rd(DEPCMD(ep));
 		if (!(v & DEPCMD_CMDACT)) {
 			uint32_t status = (v >> 12) & 0xf;
@@ -285,7 +285,8 @@ ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
 		}
 		delay(1);
 	}
-	printf("SWEET USB: ep%u cmd 0x%x timeout\n", ep, cmd & 0xf);
+	printf("SWEET USB: ep%u cmd 0x%x timeout (DEPCMD 0x%08x GSTS 0x%08x DSTS 0x%08x GUSB3PIPECTL 0x%08x)\n",
+	    ep, cmd & 0xf, dwc_rd(DEPCMD(ep)), dwc_rd(0xc118), dwc_rd(0xc70c), dwc_rd(0xc2c0));
 	return -1;
 }
 
@@ -866,11 +867,39 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	ud.dma_pa = ptoa_64(pn);
 	ud_if_create();
 
+	/*
+	 * Pixel 3: ABL runs fastboot at SuperSpeed (DSTS speed 4) through the QMP
+	 * USB3 PHY; this driver is USB 2 only. As Linux does for a high-speed-only
+	 * DWC3, let the USB3 PHY suspend (GUSB3PIPECTL bit 17) so the core does
+	 * not wait on its pipe clock (boot-arg blueusb3susp=0 skips). SDM845 GCC
+	 * USB clocks: master 0xf00c, sleep 0xf010, mock UTMI 0xf014, aux 0xf04c
+	 * (the table above has SM7150's offsets).
+	 */
+	{
+		vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+		if (gcc) {
+			printf("SWEET USB: SDM845 CBCR master 0x%08x sleep 0x%08x utmi 0x%08x aux 0x%08x\n",
+			    usb_rd(gcc, 0xf00c), usb_rd(gcc, 0xf010), usb_rd(gcc, 0xf014), usb_rd(gcc, 0xf04c));
+		}
+		int susp = 1;
+		PE_parse_boot_argn("blueusb3susp", &susp, sizeof(susp));
+		uint32_t pipe = dwc_rd(0xc2c0);
+		if (susp) {
+			dwc_wr(0xc2c0, pipe | (1u << 17));
+		}
+		printf("SWEET USB: GUSB3PIPECTL 0x%08x -> 0x%08x\n", pipe, dwc_rd(0xc2c0));
+	}
 	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
-	dwc_wr(DCTL, DCTL_CSFTRST);
-	int i;
-	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
-		delay(1000);
+	int i = 0, reset = 1;
+	PE_parse_boot_argn("blueusbreset", &reset, sizeof(reset));
+	if (reset) {
+		dwc_wr(DCTL, DCTL_CSFTRST);
+		for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+			delay(1000);
+		}
+	} else {
+		dwc_wr(DCTL, dwc_rd(DCTL) & ~(1u << 31));	/* stop (run/stop clear), no reset */
+		printf("SWEET USB: soft reset skipped (blueusbreset=0)\n");
 	}
 	printf("SWEET USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
 	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
