diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 0da3b8b..0ae41bf 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -73,9 +73,10 @@ SweetCPU::start(IOService *provider)
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
-	if (cpu->phys_id > 0x500 || (cpu->phys_id & 0xff) != 0 ||
+	/* Pixel 3: MPIDR Aff1 = core 0-7 */
+	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
 	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
-		panic("SWEET CPU: invalid A55 topology cpu=%u mpidr=0x%x count=%u",
+		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
 	}
 	if (!IOCPU::start(provider)) {
@@ -127,7 +128,7 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 	const ml_topology_info_t *topology = ml_get_topology_info();
 	uint32_t requested = 1;
 	PE_parse_boot_argn("cpus", &requested, sizeof(requested));
-	IOLog("SWEET CPU: requested=%u selected=%u (A55 limit=%u)\n",
+	IOLog("SWEET CPU: requested=%u selected=%u (limit=%u)\n",
 	    requested, topology->num_cpus, SWEET_SMP_MAX_CPUS);
 
 	uint64_t deadline;
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index a99d031..d8440cd 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -955,7 +955,7 @@ ml_parse_cpu_topology(void)
 	const boolean_t cpumask_boot_arg_present = PE_parse_boot_argn("cpumask", &cpumask_boot_arg, sizeof(cpumask_boot_arg));
 
 #if defined(SWEET)
-	/* Opt in to SMP. Never expose the A76s to this A55-only configuration. */
+	/* Opt in to SMP: cpus=N, N <= SWEET_SMP_MAX_CPUS (Pixel 3: all eight cores). */
 	if (!cpus_boot_arg_present || cpu_boot_arg == 0) {
 		cpu_boot_arg = 1;
 	}
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index 789187c..b9cd327 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -17,8 +17,12 @@
 
 #define SWEET                     1
 
-/* Six homogeneous A55s; cpus=N is clamped here until A76/AMP is audited. */
-#define SWEET_SMP_MAX_CPUS         6
+/*
+ * Pixel 3 (SDM845): eight Kryo 385 cores, 4 Silver (MPIDR 0x000-0x300)
+ * and 4 Gold (0x400-0x700), run as one homogeneous SMP cluster (both
+ * ARMv8.2, 64-byte lines, PSCI CPU_ON). cpus=N is clamped here.
+ */
+#define SWEET_SMP_MAX_CPUS         8
 
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__              8
