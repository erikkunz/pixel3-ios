diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index e032cfb..ef81fe8 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -118,6 +118,20 @@ public:
 
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
+/*
+ * QuartzCore (CAMetalContextCreate) polls IOServiceMatching("IOAcceleratorES")
+ * up to 300 times, 100 ms apart, in every process that sets up CoreAnimation.
+ * An empty service ends the polling; without a MetalPluginName Metal skips
+ * it and CoreAnimation keeps its software renderer. Boot-arg sweetaccel=0
+ * leaves it out. (Finding from the ios-topaz and ios-sailfish ports.)
+ */
+class IOAcceleratorES : public IOService
+{
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
 class IOMobileFramebufferUserClient : public IOUserClient {
 	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
 
@@ -193,6 +207,13 @@ AppleCLCD::start(IOService *provider)
 	setProperty("external", false);
 	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
 	registerService();
+	int accel = 1;
+	PE_parse_boot_argn("sweetaccel", &accel, sizeof(accel));
+	IOAcceleratorES *es = accel ? OSTypeAlloc(IOAcceleratorES) : NULL;
+	if (es != NULL && es->init() && es->attach(this)) {
+		es->registerService();
+	}
+	OSSafeReleaseNULL(es);
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
 	return true;
