+/* ---- I2C, bit-banged ---- */
+
+static void
+bb_pin(int pin, int high)
+{
+	/* released: input with pull-up; low: output enabled, driving 0 */
+	wr(east + GPIO_CFG(pin), (high ? 0u : (1u << 9)) | (2u << 6) | 3u);
+}
+
+static int
+bb_get(int pin)
+{
+	return rd(east + GPIO_IO(pin)) & 1;
+}
+
+static void
+bb_scl_high(void)
+{
+	bb_pin(BB_SCL, 1);
+	for (int i = 0; i < 1000 && !bb_get(BB_SCL); i++) {	/* clock stretching, 1 ms at most */
+		delay(1);
+	}
+}
+
+static void
+bb_start(void)
+{
+	bb_pin(BB_SDA, 1);
+	bb_scl_high();
+	delay(5);
+	bb_pin(BB_SDA, 0);
+	delay(5);
+	bb_pin(BB_SCL, 0);
+	delay(5);
+}
+
+static void
+bb_stop(void)
+{
+	bb_pin(BB_SDA, 0);
+	delay(5);
+	bb_scl_high();
+	delay(5);
+	bb_pin(BB_SDA, 1);
+	delay(5);
+}
+
+static int
+bb_write(uint8_t b)
+{
+	for (int i = 7; i >= 0; i--) {
+		bb_pin(BB_SDA, b >> i & 1);
+		delay(5);
+		bb_scl_high();
+		delay(5);
+		bb_pin(BB_SCL, 0);
+	}
+	bb_pin(BB_SDA, 1);
+	delay(5);
+	bb_scl_high();
+	int nack = bb_get(BB_SDA);
+	delay(5);
+	bb_pin(BB_SCL, 0);
+	return nack ? EIO : 0;
+}
+
+static uint8_t
+bb_read(int ack)
+{
+	uint8_t b = 0;
+
+	bb_pin(BB_SDA, 1);
+	for (int i = 0; i < 8; i++) {
+		delay(5);
+		bb_scl_high();
+		b = (uint8_t)(b << 1 | bb_get(BB_SDA));
+		delay(5);
+		bb_pin(BB_SCL, 0);
+	}
+	bb_pin(BB_SDA, !ack);
+	delay(5);
+	bb_scl_high();
+	delay(5);
+	bb_pin(BB_SCL, 0);
+	bb_pin(BB_SDA, 1);
+	return b;
+}
