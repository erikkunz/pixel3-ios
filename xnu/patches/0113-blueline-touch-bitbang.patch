+/* n commands (addr, data) in an idle active TCS, triggered and waited for. */
+static int
+rpmh_write(const uint32_t *addr, const uint32_t *data, int n)
+{
+	uint32_t cstride = (rd(rsc) >> 16 & 0xffu) >= 3 ? 24 : 20;
+	int t = -1;
+
+	for (int i = 0; i < 2 && t < 0; i++) {
+		vm_offset_t b = rsc + RSC_TCS + TCS_STRIDE * (uint32_t)i;
+		if (rd(b + 0x18) && !rd(b + 0x14) && !rd(b + 0x1c)) {	/* idle, no control, no commands */
+			t = i;
+		}
+	}
+	if (t < 0) {
+		return EBUSY;
+	}
+	vm_offset_t b = rsc + RSC_TCS + TCS_STRIDE * (uint32_t)t;
+	wr(rsc + RSC_TCS + 0x08, 1u << t);		/* IRQ_CLEAR */
+	for (int i = 0; i < n; i++) {
+		wr(b + 0x30 + cstride * (uint32_t)i, 8u | (1u << 16) | (1u << 8));	/* write, response */
+		wr(b + 0x34 + cstride * (uint32_t)i, addr[i]);
+		wr(b + 0x38 + cstride * (uint32_t)i, data[i]);
 	}
-	if (read) {
