+/* ---- RPMh: LDO19 from the AOP ---- */
+
+static uint8_t
+rd8(vm_offset_t a)
+{
+	return *(volatile uint8_t *)a;
+}
+
+static uint32_t
+cmddb_addr(const char *id)
+{
+	vm_offset_t loc = ml_io_map(CMDDB_LOC_PA & ~0xfffu, 0x1000);
+	if (!loc) {
+		return 0;
+	}
+	uint32_t pa = rd(loc + (CMDDB_LOC_PA & 0xfffu)), size = rd(loc + (CMDDB_LOC_PA & 0xfffu) + 4);
+	if (!pa || size < 0x1000 || size > 0x100000) {
+		return 0;
+	}
+	vm_offset_t db = ml_io_map(pa, size);
+	if (!db || rd(db + 4) != 0x0c0330dbu) {		/* magic db 30 03 0c */
+		return 0;
+	}
+	for (uint32_t i = 0; i < 8; i++) {
+		vm_offset_t h = db + 8 + 16 * i;	/* rsc_hdr: slv_id, header_offset, data_offset, cnt */
+		uint32_t slv = rd8(h) | (uint32_t)rd8(h + 1) << 8;
+		if (!slv) {
 			break;
 		}
-		delay(1);
+		uint32_t hoff = rd8(h + 2) | (uint32_t)rd8(h + 3) << 8;
+		uint32_t cnt = rd8(h + 6) | (uint32_t)rd8(h + 7) << 8;
+		vm_offset_t e = db + 144 + hoff;	/* entry_header: id[8], priority[2], addr, len, offset */
+		for (uint32_t j = 0; j < cnt && 144 + hoff + 24 * (j + 1) <= size; j++, e += 24) {
+			bool same = true;
+			for (int k = 0; k < 8 && same; k++) {
+				same = rd8(e + k) == (uint8_t)id[k];
+				if (!id[k]) {
+					break;
+				}
+			}
+			if (same) {
+				return rd(e + 16);
+			}
+		}
 	}
-	wr(se + SE_M_IRQ_CLR, st);
-	if (!(st & M_CMD_DONE) || (st & M_ERRORS)) {
-		return EIO;
