-		for (uint32_t i = 0; i < words; i++) {
-			uint32_t word = rd(se + SE_RX_FIFO);
-			for (uint32_t b = 0; b < 4 && got < len; b++) {
-				rx[got++] = (uint8_t)(word >> (8 * b));
+	wr(b + 0x1c, (1u << n) - 1);			/* CMD_ENABLE */
+	wr(b + 0x14, 0);				/* CONTROL: AMC on, then trigger */
+	wr(b + 0x14, 1u << 16);
+	wr(b + 0x14, (1u << 16) | (1u << 24));
+	bool done = false;
+	for (int us = 0; us < 50000 && !done; us++) {
+		done = true;
+		for (int i = 0; i < n; i++) {
+			if (!(rd(b + 0x3c + cstride * (uint32_t)i) & (1u << 16))) {	/* completed */
+				done = false;
 			}
 		}
-		if (got < len) {
-			return EIO;
-		}
+		delay(1);
 	}
-	return 0;
+	wr(b + 0x1c, 0);
+	wr(b + 0x14, 0);
+	wr(rsc + RSC_TCS + 0x08, 1u << t);
+	return done ? 0 : ETIMEDOUT;
 }
 
