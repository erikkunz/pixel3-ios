+/* ---- FTM5 ---- */
+
+static const uint8_t fifo_cmd[1] = { 0x86 };
+
+static void
+fts_start(void)
+{
+	static const uint8_t reset[6] = { 0xfa, 0x20, 0x00, 0x00, 0x24, 0x80 };
+	static const uint8_t irq_on[6] = { 0xfa, 0x20, 0x00, 0x00, 0x29, 0x41 };
+	static const uint8_t sense_on[3] = { 0xa0, 0x00, 0xff };
+	uint8_t e[8];
+	bool ready = false;
+
+	int e0 = fts_xfer(reset, sizeof(reset), NULL, 0);
+	for (int i = 0; i < 50 && !ready; i++) {
+		delay(10000);
+		ready = fts_xfer(fifo_cmd, 1, e, 8) == 0 && e[0] == 0x03;
+	}
+	int e1 = fts_xfer(irq_on, sizeof(irq_on), NULL, 0);
+	int e2 = fts_xfer(sense_on, sizeof(sense_on), NULL, 0);
+	printf("BLUELINE TOUCH: reset err=%d %s, irq err=%d, sense on err=%d\n",
+	    e0, ready ? "ready" : "NOT ready", e1, e2);
 }
 
