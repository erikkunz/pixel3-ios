From 7fa2d3ac33f713eb8902814221a8449ac8c32495 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 23 Oct 2026 00:42:45 +0200
Subject: [PATCH] 0121: GIC SPI attach/dispatch (ios-sailfish 0181), touch on
 the TLMM summary interrupt, moves coalesced to 60/s

---
 bsd/dev/blueline_touch.c | 87 +++++++++++++++++++++++++++++++++++-----
 osfmk/arm64/sleh.c       |  8 +++-
 pexpert/arm/pe_fiq.c     | 76 +++++++++++++++++++++++++++++++++++
 3 files changed, 161 insertions(+), 10 deletions(-)

diff --git a/bsd/dev/blueline_touch.c b/bsd/dev/blueline_touch.c
index b9d59b0..64e647e 100644
--- a/bsd/dev/blueline_touch.c
+++ b/bsd/dev/blueline_touch.c
@@ -24,14 +24,22 @@
  *
  * Events (command 0x86, 8 bytes each, byte 7 bits 4:0 = events still queued):
  * byte 0 high nibble 1 enter, 2 motion, 3 leave; byte 1 = id << 4 | type
- * (1 finger); x = (b3 & 0xf) << 8 | b2, y = b4 << 4 | b3 >> 4. Read while
- * the IRQ line (GPIO 125, active low) says events are pending, and every
- * 100 ms regardless. Boot-arg bluetouch=0 turns all of this off.
+ * (1 finger); x = (b3 & 0xf) << 8 | b2, y = b4 << 4 | b3 >> 4.
+ *
+ * When to read (ios-sailfish 0181/0182): the attention line, GPIO 125 level
+ * low, as an interrupt through the TLMM summary interrupt (GIC SPI 208,
+ * INTID 240); the handler masks the pin and wakes the thread, which reads
+ * the FIFO and unmasks it. With a finger down it reads every 20 ms anyway
+ * (the lift is never missed); idle, it sleeps until the interrupt or a
+ * second. Moves are passed on at most every 16 ms per finger; down and up
+ * always. Boot-arg bluetouchirq=0: poll every 10 ms as before. Boot-arg
+ * bluetouch=0 turns all of this off.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <kern/clock.h>
+#include <mach/mach_time.h>
 #include <kern/thread.h>
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
@@ -58,6 +66,19 @@ void blueline_touch_init(void);
 #define FTS_ADDR	0x49u
 #define MAX_FINGERS	10
 
+/* TLMM per-pin interrupt registers (pinctrl-msm): CFG bit 0 enable, 1 polarity
+ * (0 low), 3:2 detection (0 level), 4 raw status, 7:5 target (3 = apps);
+ * STATUS bit 0, cleared by writing 0. */
+#define TLMM_INTR_CFG(n)	(0x1000u * (n) + 0x8u)
+#define TLMM_INTR_STATUS(n)	(0x1000u * (n) + 0xcu)
+#define TLMM_INTR_CFG_ON	((3u << 5) | (1u << 4))
+#define TOUCH_IRQ_INTID		240u	/* TLMM summary: GIC SPI 208 */
+#define TOUCH_MOVE_NS		16000000ull
+extern bool sweet_spi_attach(uint32_t intid, bool edge, void (*fn)(void *arg), void *arg);
+extern void sweet_spi_mask(uint32_t intid, bool masked);
+static volatile bool touch_irq_on;
+static volatile uint32_t touch_irqs, touch_irq_others;
+
 static vm_offset_t east, north, rsc;
 static int touch_chan;
 
@@ -301,6 +322,34 @@ touch_power(void)
 
 static const uint8_t fifo_cmd[1] = { 0x86 };
 
+static void
+touch_irq(__unused void *arg)
+{
+	if (rd(east + TLMM_INTR_STATUS(TOUCH_IRQ)) & 1u) {
+		wr(east + TLMM_INTR_CFG(TOUCH_IRQ), TLMM_INTR_CFG_ON);	/* masked until the thread has read */
+		wr(east + TLMM_INTR_STATUS(TOUCH_IRQ), 0);
+		touch_irqs++;
+		thread_wakeup(&touch_chan);
+	} else if (++touch_irq_others > 1000) {
+		sweet_spi_mask(TOUCH_IRQ_INTID, true);	/* another pin holds the summary line: poll */
+		touch_irq_on = false;
+		thread_wakeup(&touch_chan);
+	}
+}
+
+/* Sleep up to ms; with the interrupt on, unmask the pin first (after assert_wait: no lost wakeup). */
+static void
+touch_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_chan, THREAD_UNINT, deadline);
+	if (touch_irq_on) {
+		wr(east + TLMM_INTR_CFG(TOUCH_IRQ), TLMM_INTR_CFG_ON | 1u);
+	}
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
 static void
 fts_start(void)
 {
@@ -327,11 +376,13 @@ touch_thread(__unused void *arg, __unused wait_result_t wr_)
 	uint8_t buf[8 * 32];
 	uint32_t down = 0;
 	int x[MAX_FINGERS] = { 0 }, y[MAX_FINGERS] = { 0 };
+	uint64_t sent[MAX_FINGERS] = { 0 }, move_abs;
 	unsigned errors = 0, ticks = 0;
 
+	nanoseconds_to_absolutetime(TOUCH_MOVE_NS, &move_abs);
 	for (;;) {
 		/* IRQ low: events pending; otherwise only every 100 ms (or while a finger is down) */
-		if (!(rd(east + GPIO_IO(TOUCH_IRQ)) & 1) || down || (++ticks % 10u) == 0) {
+		if (touch_irq_on || !(rd(east + GPIO_IO(TOUCH_IRQ)) & 1) || down || (++ticks % 10u) == 0) {
 			int err = fts_xfer(fifo_cmd, 1, buf, 8);
 			if (!err && buf[0] != 0) {
 				unsigned more = buf[7] & 0x1fu;
@@ -347,10 +398,15 @@ touch_thread(__unused void *arg, __unused wait_result_t wr_)
 					if ((kind == 1 || kind == 2) && type != 0 && type != 3) {
 						x[id] = ((ev[3] & 0xf) << 8) | ev[2];
 						y[id] = (ev[4] << 4) | (ev[3] >> 4);
+						uint64_t t = mach_absolute_time();
+						if (!(down & (1u << id)) || t - sent[id] >= move_abs) {
+							sweet_hid_touch((int)id, 1, x[id], y[id]);
+							sent[id] = t;
+						}
 						down |= 1u << id;
-						sweet_hid_touch((int)id, 1, x[id], y[id]);
 					} else if (kind == 3 && (down & (1u << id))) {
 						down &= ~(1u << id);
+						sweet_hid_touch((int)id, 1, x[id], y[id]);	/* the last position, then the lift */
 						sweet_hid_touch((int)id, 0, x[id], y[id]);
 					}
 				}
@@ -358,10 +414,15 @@ touch_thread(__unused void *arg, __unused wait_result_t wr_)
 				printf("BLUELINE TOUCH: FIFO read error\n");
 			}
 		}
-		uint64_t deadline;
-		clock_interval_to_deadline(10, NSEC_PER_MSEC, &deadline);
-		(void)assert_wait_deadline(&touch_chan, THREAD_UNINT, deadline);
-		thread_block(THREAD_CONTINUE_NULL);
+		if (touch_irq_on) {
+			touch_sleep(down ? 20 : 1000);
+		} else {
+			if (touch_irq_others > 1000 && touch_irq_others < 2000) {
+				touch_irq_others = 2000;
+				printf("BLUELINE TOUCH: summary interrupt held by another pin (%u interrupts): polling\n", touch_irqs);
+			}
+			touch_sleep(10);
+		}
 	}
 }
 
@@ -415,6 +476,14 @@ blueline_touch_init(void)
 	    id[0], id[1], id[2], id[3]);
 	(void)touch_power();
 	fts_start();
+	int irq = 1;
+	(void)PE_parse_boot_argn("bluetouchirq", &irq, sizeof(irq));
+	if (irq) {
+		wr(east + TLMM_INTR_CFG(TOUCH_IRQ), TLMM_INTR_CFG_ON);
+		wr(east + TLMM_INTR_STATUS(TOUCH_IRQ), 0);
+		touch_irq_on = sweet_spi_attach(TOUCH_IRQ_INTID, false, touch_irq, NULL);
+	}
+	printf("BLUELINE TOUCH: %s\n", touch_irq_on ? "interrupt-driven (INTID 240)" : "polling every 10 ms");
 	if (kernel_thread_start(touch_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 0e1394e..4233d40 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1895,6 +1895,10 @@ handle_simd_trap(arm_saved_state_t *state, uint32_t esr)
 	__builtin_unreachable();
 }
 
+#if defined(SWEET)
+extern bool sweet_spi_dispatch(uint32_t intid);	/* pexpert/arm/pe_fiq.c (ios-sailfish 0181) */
+#endif
+
 void
 sleh_irq(arm_saved_state_t *state)
 {
@@ -1930,7 +1934,9 @@ sleh_irq(arm_saved_state_t *state)
 		cpu_signal_handler();
 	} else {
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
-		if (cdp->interrupt_handler) {
+		if (sweet_spi_dispatch(intid)) {
+			/* a SWEET driver's device interrupt (pexpert/arm/pe_fiq.c) */
+		} else if (cdp->interrupt_handler) {
 			cdp->interrupt_handler(cdp->interrupt_target,
 			    cdp->interrupt_refCon,
 			    cdp->interrupt_nub,
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..ec9b97f 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -73,6 +73,82 @@ find_gicr_pe_base()
 	panic("%s: cannot find GICR base for core %u", __func__, ml_get_cpu_number(phys_id));
 }
 
+#if defined(SWEET)
+/*
+ * Device interrupts (GIC SPIs, INTIDs 32..1019) for SWEET drivers, after
+ * HackiOS's gic_v3_spi_attach() (github.com/oosexgang/hackios-xnu-kernel,
+ * osfmk/arm64/gic_v3_irq.c, APSL 2.0): configured (edge/level), routed to
+ * the processor that attaches it, enabled; its handler runs in interrupt
+ * context (sleh_irq -> sweet_spi_dispatch) and must quiet the device
+ * before returning (the interrupt is ended after it).
+ */
+#define GICD_ISENABLER(n)       (0x0100 + 4 * (n))
+#define GICD_ICENABLER(n)       (0x0180 + 4 * (n))
+#define GICD_IPRIORITYR(n)      (0x0400 + (n))
+#define GICD_ICFGR(n)           (0x0C00 + 4 * (n))
+#define GICD_IROUTER(n)         (0x6000 + 8 * (n))
+#define SWEET_SPI_MAX           1020
+
+static struct {
+	void (*fn)(void *arg);
+	void *arg;
+} sweet_spi[SWEET_SPI_MAX];
+
+static void
+sweet_gicd_rwp(void)
+{
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+}
+
+bool sweet_spi_attach(uint32_t intid, bool edge, void (*fn)(void *arg), void *arg);
+void sweet_spi_mask(uint32_t intid, bool masked);
+bool sweet_spi_dispatch(uint32_t intid);
+
+bool
+sweet_spi_attach(uint32_t intid, bool edge, void (*fn)(void *arg), void *arg)
+{
+	if (intid < 32 || intid >= SWEET_SPI_MAX || fn == NULL || gicd_base == 0) {
+		return false;
+	}
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1") & 0xFF00FFFFFFULL;   /* Aff3, Aff2.1.0 */
+	gicd_write32(GICD_ICENABLER(intid / 32), 1u << (intid % 32));
+	sweet_gicd_rwp();
+	sweet_spi[intid].arg = arg;
+	sweet_spi[intid].fn = fn;
+	__builtin_arm_dmb(DMB_ISH);
+	uint32_t cfg = gicd_read32(GICD_ICFGR(intid / 16)), bit = 2u << (2 * (intid % 16));
+	gicd_write32(GICD_ICFGR(intid / 16), edge ? (cfg | bit) : (cfg & ~bit));
+	*(volatile uint8_t *)(gicd_base + GICD_IPRIORITYR(intid)) = 0xA0;
+	*(volatile uint64_t *)(gicd_base + GICD_IROUTER(intid)) = mpidr;
+	gicd_write32(GICD_ISENABLER(intid / 32), 1u << (intid % 32));
+	sweet_gicd_rwp();
+	kprintf("SWEET GIC: SPI intid %u (%s) attached, routed to MPIDR 0x%llx\n", intid, edge ? "edge" : "level", mpidr);
+	return true;
+}
+
+/* Masked: the line stays quiet at the GIC (a driver giving up on a storming interrupt). */
+void
+sweet_spi_mask(uint32_t intid, bool masked)
+{
+	if (intid >= 32 && intid < SWEET_SPI_MAX && gicd_base) {
+		gicd_write32(masked ? GICD_ICENABLER(intid / 32) : GICD_ISENABLER(intid / 32), 1u << (intid % 32));
+	}
+}
+
+/* From sleh_irq: false if nobody attached the INTID. */
+bool
+sweet_spi_dispatch(uint32_t intid)
+{
+	if (intid >= SWEET_SPI_MAX || sweet_spi[intid].fn == NULL) {
+		return false;
+	}
+	sweet_spi[intid].fn(sweet_spi[intid].arg);
+	return true;
+}
+#endif /* SWEET */
+
 void
 pe_init_fiq()
 {
