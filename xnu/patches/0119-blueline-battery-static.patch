diff --git a/iokit/Kernel/arm/BlueBattery.cpp b/iokit/Kernel/arm/BlueBattery.cpp
new file mode 100644
index 0000000..5f60673
--- /dev/null
+++ b/iokit/Kernel/arm/BlueBattery.cpp
@@ -0,0 +1,122 @@
+/*
+ * Pixel 3 (blueline) battery for iOS, static for now: 100 %, on external
+ * power, full, not charging (2915 mAh, the Pixel 3's design capacity).
+ * Without any IOPMPowerSource iOS shows an empty battery and no percentage.
+ * Nothing is read from the PMIC yet (PMI8998 fuel gauge: later). Pattern as
+ * ios-sweet's SweetBattery (0062): matched on IOResources, the complete
+ * source published before registerService() wakes powerd.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <libkern/c++/OSCollectionIterator.h>
+
+#define BLUE_BATTERY_MAH	2915u
+
+class BlueBattery : public IOPMPowerSource {
+	OSDeclareDefaultStructors(BlueBattery);
+public:
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+private:
+	void putNumber(const char *key, UInt32 value);
+	void putBool(const char *key, bool value);
+};
+OSDefineMetaClassAndStructors(BlueBattery, IOPMPowerSource);
+
+bool
+BlueBattery::init(OSDictionary *dictionary)
+{
+	/* IOCatalogue calls init(dictionary); IOPMPowerSource only has init(void). */
+	if (!IOPMPowerSource::init()) {
+		return false;
+	}
+	if (dictionary) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dictionary);
+		if (!it) {
+			return false;
+		}
+		OSObject *object;
+		while ((object = it->getNextObject())) {
+			const OSSymbol *key = OSDynamicCast(OSSymbol, object);
+			if (key) {
+				setProperty(key, dictionary->getObject(key));
+			}
+		}
+		it->release();
+	}
+	return true;
+}
+
+void
+BlueBattery::putNumber(const char *key, UInt32 value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	OSNumber *number = OSNumber::withNumber(value, 32);
+	if (symbol && number) {
+		setPSProperty(symbol, number);
+	}
+	OSSafeReleaseNULL(number);
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+BlueBattery::putBool(const char *key, bool value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	if (symbol) {
+		setPSProperty(symbol, value ? kOSBooleanTrue : kOSBooleanFalse);
+		symbol->release();
+	}
+}
+
+bool
+BlueBattery::start(IOService *provider)
+{
+	if (!IOPMPowerSource::start(provider)) {
+		return false;
+	}
+	setBatteryInstalled(true);
+	setCurrentCapacity(BLUE_BATTERY_MAH);
+	setMaxCapacity(BLUE_BATTERY_MAH);
+	setExternalConnected(true);
+	setExternalChargeCapable(true);
+	setIsCharging(false);
+	setAtWarnLevel(false);
+	setAtCriticalLevel(false);
+	setVoltage(4350);
+	setAmperage(0);
+	setTimeRemaining(-1);
+	setCycleCount(0);
+	putBool("FullyCharged", true);
+	putBool("AppleRawExternalConnected", true);
+	putNumber("AppleRawCurrentCapacity", BLUE_BATTERY_MAH);
+	putNumber("AppleRawMaxCapacity", BLUE_BATTERY_MAH);
+	putNumber("DesignCapacity", BLUE_BATTERY_MAH);
+	putNumber("InstantAmperage", 0);
+	putNumber("Temperature", 2500);		/* centidegrees, fixed */
+
+	/* IOPMCopyBatteryInfo's per-source compatibility dictionary */
+	OSDictionary *legacy = OSDictionary::withCapacity(6);
+	if (legacy) {
+		const char *keys[] = { kIOBatteryCurrentChargeKey, kIOBatteryCapacityKey,
+			               kIOBatteryVoltageKey, kIOBatteryAmperageKey, kIOBatteryCycleCountKey,
+			               kIOBatteryFlagsKey };
+		UInt32 values[] = { BLUE_BATTERY_MAH, BLUE_BATTERY_MAH, 4350, 0, 0,
+			            (UInt32)(kIOBatteryInstalled | kIOBatteryChargerConnect) };
+		for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); i++) {
+			OSNumber *number = OSNumber::withNumber(values[i], 32);
+			if (number) {
+				legacy->setObject(keys[i], number);
+				number->release();
+			}
+		}
+		setLegacyIOBatteryInfo(legacy);
+		legacy->release();
+	}
+	updateStatus();
+	IOLog("BLUELINE BATTERY: static source, 100%% on external power\n");
+	registerService();
+	return true;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
