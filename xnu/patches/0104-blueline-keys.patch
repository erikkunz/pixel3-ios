diff --git a/bsd/dev/blueline_keys.c b/bsd/dev/blueline_keys.c
new file mode 100644
index 0000000..33c355a
--- /dev/null
+++ b/bsd/dev/blueline_keys.c
@@ -0,0 +1,157 @@
+/*
+ * Pixel 3 (blueline) hardware keys, polled every 20 ms:
+ *   power       PM8998 PON (SID 0, peripheral 0x08) INT_RT_STS bit 0 (KPDPWR)
+ *   volume down PM8998 PON INT_RT_STS bit 1 (RESIN)
+ * Volume up (PM8998 GPIO 6, active low) is not read yet: as ABL leaves it
+ * (input, no pull-up configured, interrupt off) neither STATUS1 nor
+ * INT_RT_STS follows the key (p3-input probe), and this driver never
+ * writes PMIC registers.
+ * read through the SDM845 PMIC arbiter (v5) observer channel, and passed
+ * to the HID services (iokit/Kernel/arm/hid/SweetHID.cpp) as keys
+ * 0 power, 1 volume up, 2 volume down. Boot-arg bluekeys=0: off.
+ *
+ * Read-only: the only MMIO writes are EXT_READL commands to this EE's
+ * observer channel. No PMIC register is written, no IRQ acknowledged.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+void blueline_keys_init(void);
+
+#define ARB_CORE_PA	0x0c440000u	/* version, features, APID -> PPID map */
+#define ARB_OBS_PA	0x0e600000u	/* read-only observer channels */
+#define ARB_CNFG_PA	0x0c40a000u	/* APID ownership */
+#define PPID_PON	0x008u
+#define PPID_GPIO6	0x0c5u
+#define PON_RT_STS	0x0810u
+#define NO_APID		0xffffu
+
+static vm_offset_t arb_core, arb_obs, arb_cnfg;
+static uint16_t pon_apid = NO_APID, gpio_apid = NO_APID;
+static uint32_t arb_status;
+static int keys_chan;
+
+static uint32_t
+arb_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* A PPID can be mapped more than once; prefer the entry the apps EE owns. */
+static uint16_t
+arb_apid(uint16_t ppid, uint32_t count)
+{
+	uint16_t found = NO_APID;
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t map = arb_rd(arb_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		if (found == NO_APID || (arb_rd(arb_cnfg, 0x700u + 4u * i) & 7u) == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+/* One-byte EXT_READL on observer channel apid (EE 0). */
+static bool
+arb_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	if (apid == NO_APID) {
+		return false;
+	}
+	vm_offset_t ch = arb_obs + 0x80u * apid;
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)ch = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; i++) {
+		arb_status = arb_rd(ch, 0x08u);
+		if (arb_status & 1u) {
+			if (arb_status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)arb_rd(ch, 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+keys_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int state[3] = { 0, 0, 0 };
+	unsigned errors = 0;
+	for (;;) {
+		uint8_t pon = 0;
+		bool pok = arb_read(pon_apid, PON_RT_STS, &pon);
+		int now[3] = { !!(pon & 1u), 0, !!(pon & 2u) };
+		bool ok[3] = { pok, false, pok };	/* no volume up yet */
+		if (!pok && (errors++ % 250u) == 0) {
+			printf("BLUELINE KEYS: PON read error, arbiter status %#x\n", arb_status);
+		}
+		for (int k = 0; k < 3; k++) {
+			if (ok[k] && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("BLUELINE KEYS: key %d %s\n", k, state[k] ? "down" : "up");
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		uint64_t deadline;
+		clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&keys_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void
+blueline_keys_init(void)
+{
+	static bool started;
+	int enabled = 1;
+	thread_t thread;
+
+	if (started) {
+		return;
+	}
+	started = true;
+	(void)PE_parse_boot_argn("bluekeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("BLUELINE KEYS: off (bluekeys=0)\n");
+		return;
+	}
+	arb_core = ml_io_map(ARB_CORE_PA, 0x2000);
+	arb_cnfg = ml_io_map(ARB_CNFG_PA, 0x1000);
+	arb_obs = ml_io_map(ARB_OBS_PA, 0x10000);
+	if (!arb_core || !arb_cnfg || !arb_obs) {
+		printf("BLUELINE KEYS: MMIO mapping failed\n");
+		return;
+	}
+	uint32_t version = arb_rd(arb_core, 0), count = arb_rd(arb_core, 4) & 0x7ffu;
+	if (version < 0x50000000u || version >= 0x70000000u || count == 0 || count > 512) {
+		printf("BLUELINE KEYS: arbiter %#x with %u APIDs is not v5; keys off\n", version, count);
+		return;
+	}
+	pon_apid = arb_apid(PPID_PON, count);
+	gpio_apid = arb_apid(PPID_GPIO6, count);
+	printf("BLUELINE KEYS: arbiter %#x, PON APID %u, GPIO6 APID %u\n", version, pon_apid, gpio_apid);
+	if (pon_apid == NO_APID) {
+		return;
+	}
+	if (kernel_thread_start(keys_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
